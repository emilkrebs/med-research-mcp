# med-research-mcp — environment variables
#
# Every variable is optional, but setting NCBI_EMAIL is strongly recommended.
# The server doesn't read a .env file itself: set the variables in your MCP
# client's env block (Claude Desktop, Cursor, etc.), or copy this file to .env
# (gitignored) and load it yourself, e.g. `node --env-file=.env
# dist/http/index.js` or `docker run --env-file .env ...`.

# ─── NCBI E-utilities (PubMed) ──────────────────────────────────
# Contact email of whoever runs this installation, sent with every NCBI request
# together with tool=med-research-mcp, as NCBI's usage policy asks. NCBI uses it
# to reach you before blocking an IP that exceeds its limits; it doesn't raise
# them. Left empty, requests carry the project's contact address instead. Also
# the fallback for the Unpaywall and ChinaRxiv emails below.
NCBI_EMAIL=

# NCBI API key. Optional — raises the rate limit from 3 to 10 requests/second.
# Get one at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# ─── ChinaRxiv / RussiaRxiv ──────────────────────────────────────
# Contact email sent as X-API-Email, raising the ChinaRxiv rate limit from
# 30 to 300 requests/minute. Falls back to NCBI_EMAIL when unset.
MED_RESEARCH_CHINAXIV_EMAIL=

# ─── literature_fulltext (optional) ─────────────────────────────
# Contact email for Unpaywall open-access lookups. Falls back to NCBI_EMAIL,
# then to the project's contact address, so you usually don't need to set this
# separately.
MED_RESEARCH_UNPAYWALL_EMAIL=

# Institutional EZproxy host for doi.org, tried after Unpaywall for paywalled
# articles. literature_fulltext requests <prefix>/<DOI>, so .../login?url=
# prefixes don't work. It works only if the proxy lets this machine in without a
# login (e.g. on the campus network or VPN): the server sends no browser cookies,
# so a proxy login in your browser isn't used. Use it only if your institution's
# licences allow this use — many publishers forbid using subscription content
# with AI tools — and never for bulk downloads.
# Example: https://doi-org.ezproxy.your-university.edu
MED_RESEARCH_PROXY_PREFIX=

# Cap on returned full-text length, in characters. Default 50000.
MED_RESEARCH_FULLTEXT_MAX_CHARS=

# Set to 1 to let full-text fetches reach private or reserved network addresses,
# which are refused by default (they could reach internal services or cloud
# metadata). Only for a personal machine behind a fake-IP DNS proxy (Clash,
# Surge or sing-box in TUN mode) or split-horizon DNS. Never on a shared server.
MED_RESEARCH_FULLTEXT_ALLOW_PRIVATE=

# ─── Caching (optional) ─────────────────────────────────────────
# Cache backend: "memory" (default, dies with the process) or "sqlite"
# (persistent across restarts).
MED_RESEARCH_CACHE_BACKEND=

# SQLite database path when the backend is "sqlite". Default ./pubmed-cache.db
# Use ":memory:" for an ephemeral database.
MED_RESEARCH_CACHE_PATH=

# ─── Hosted HTTP server (src/http/index.ts) ─────────────────────
# Only used by `npm run start:http` / `dev:http`. See docs/hosting.md.
# PORT=8787
# HOST=127.0.0.1

# Bearer token required on /mcp. Unset = anonymous access (evaluation only).
MED_RESEARCH_HTTP_TOKEN=

# Per-IP token bucket on /mcp: sustained requests/min and burst capacity.
# MED_RESEARCH_HTTP_RATE_PER_MIN=60
# MED_RESEARCH_HTTP_BURST=20

# Requests processed at once, process-wide (queue of 100 beyond → 503).
# MED_RESEARCH_HTTP_MAX_CONCURRENCY=8

# Max POST body size in bytes (→ 413 beyond).
# MED_RESEARCH_HTTP_MAX_BODY_BYTES=1000000

# Set to 1 behind a reverse proxy so the client IP comes from the last
# X-Forwarded-For entry, the one the proxy added. Leave unset otherwise —
# without a proxy in front, the header is spoofable.
# MED_RESEARCH_TRUST_PROXY=0

# Comma-separated Host header allowlist; enables DNS-rebinding protection.
# MED_RESEARCH_ALLOWED_HOSTS=

