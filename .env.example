# med-research-mcp — environment variables
#
# Copy to .env (gitignored) and fill in what you need. Every variable is
# optional, but setting NCBI_EMAIL is strongly recommended. The MCP client
# (Claude Desktop, Cursor, etc.) can also inject these via its server config.

# ─── NCBI E-utilities (PubMed) ──────────────────────────────────
# Contact email. NCBI asks for one on every request; without it you're more
# likely to be throttled. Also used as the Unpaywall fallback email below.
NCBI_EMAIL=

# NCBI API key. Optional — raises the rate limit from 3 to 10 requests/second.
# Get one at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# ─── literature_fulltext (optional) ─────────────────────────────
# Contact email for Unpaywall open-access lookups. Falls back to NCBI_EMAIL
# when unset, so you usually don't need to set this separately.
MED_RESEARCH_UNPAYWALL_EMAIL=

# Institutional EZproxy host for doi.org, tried after Unpaywall for paywalled
# articles. literature_fulltext requests <prefix>/<DOI>, so .../login?url=
# prefixes don't work. Use it only as your institution's and the publishers'
# terms allow (typically personal research use, no automated bulk downloads).
# Example: https://doi-org.ezproxy.your-university.edu
MED_RESEARCH_PROXY_PREFIX=

# Cap on returned full-text length, in characters. Default 50000.
MED_RESEARCH_FULLTEXT_MAX_CHARS=

# ─── Caching (optional) ─────────────────────────────────────────
# Cache backend: "memory" (default, dies with the process) or "sqlite"
# (persistent across restarts).
MED_RESEARCH_CACHE_BACKEND=

# SQLite database path when the backend is "sqlite". Default ./pubmed-cache.db
# Use ":memory:" for an ephemeral database.
MED_RESEARCH_CACHE_PATH=
