# Copy to benchmark/.env (or export in your shell) and fill in.
# The benchmark reads these from the process environment.

# Model providers — only the ones your selected models (and the judge) use are required.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Condition B (web search) — Brave Search API, free tier.
BRAVE_API_KEY=

# NCBI — a contact email avoids throttling; an API key raises the rate limit to 10 req/s.
NCBI_EMAIL=
NCBI_API_KEY=

# Optional: unpaywall email for literature_fulltext open-access lookups (condition C).
MED_RESEARCH_UNPAYWALL_EMAIL=

# Optional judge overrides (defaults: openai / gpt-4o-2024-08-06).
# BENCH_JUDGE_PROVIDER=openai
# BENCH_JUDGE_MODEL=gpt-4o-2024-08-06
# BENCH_JUDGE_KEY_ENV=OPENAI_API_KEY

# Optional composite normalization references.
# BENCH_SPEED_REF_S=60
# BENCH_TOKEN_REF=20000
