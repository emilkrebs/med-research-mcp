# Copy to benchmark/.env (or export in your shell) and fill in.
# The benchmark reads these from the process environment.

# Model providers — only the ones your selected models use are required.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional custom base URLs — set the env var name you referenced in ModelSpec.baseUrlEnv.
# Useful for proxies, local servers (e.g. Ollama), or Azure OpenAI endpoints.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Web-search baseline (optional) — Brave Search API, free tier.
# Only required when running with --with-baselines or --conditions B.
BRAVE_API_KEY=

# NCBI — a contact email avoids throttling; an API key raises the rate limit to 10 req/s.
NCBI_EMAIL=
NCBI_API_KEY=

# Optional: unpaywall email for literature_fulltext open-access lookups (MCP condition).
MED_RESEARCH_UNPAYWALL_EMAIL=

# Optional composite normalization references.
# BENCH_SPEED_REF_S=60
# BENCH_TOKEN_REF=20000
