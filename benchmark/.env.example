# Copy to benchmark/.env (or export in your shell) and fill in.
# The benchmark reads these from the process environment.

# Model providers — only the ones your selected models use are required.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional custom base URLs — set the env var name you referenced in ModelSpec.baseUrlEnv.
# Useful for proxies, local servers (e.g. Ollama), or Azure OpenAI endpoints.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Ollama (local) — no key needed; OLLAMA_API_KEY is only for a remote/proxied server.
# IMPORTANT: Ollama's default context is 4096 tokens and its OpenAI-compatible API can't raise it
# per request. Start the server with OLLAMA_CONTEXT_LENGTH=32768 (or larger), e.g.
#   OLLAMA_CONTEXT_LENGTH=32768 ollama serve
# otherwise tool results silently push the question out of the window and results are invalid
# (such runs are detected and scored as `truncated`).
# OLLAMA_BASE_URL defaults to http://localhost:11434/v1.
# OLLAMA_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Web-search baseline (optional) — Brave Search API, free tier.
# Only required when running with --with-baselines or --conditions B.
BRAVE_API_KEY=

# NCBI — a contact email avoids throttling; an API key raises the rate limit to 10 req/s.
NCBI_EMAIL=
NCBI_API_KEY=

# Optional: unpaywall email for literature_fulltext open-access lookups (MCP condition).
MED_RESEARCH_UNPAYWALL_EMAIL=

# Optional composite normalization references.
# BENCH_SPEED_REF_S=60
# BENCH_TOKEN_REF=20000

# Optional wall-clock cap (ms) for one agent loop; a run exceeding it is recorded as a timeout error.
# BENCH_TIMEOUT_MS=300000
