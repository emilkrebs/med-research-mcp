{
  "name": "med-research-mcp-benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Benchmark harness for med-research-mcp. Default run tests the MCP; optional closed-book and web-search baselines are available for comparison.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "bench": "tsx run.ts",
    "smoke": "tsx run.ts --runs 1 --queries factual-01",
    "smoke-baselines": "tsx run.ts --runs 1 --with-baselines --queries factual-01",
    "grade": "tsx grade.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.75",
    "@ai-sdk/deepseek": "^3.0.61",
    "@ai-sdk/openai": "^4.0.87",
    "ai": "^7.0.131",
    "d3": "^7.9.0",
    "jsdom": "^30.1.2"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
