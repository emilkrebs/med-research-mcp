{
  "name": "med-research-mcp",
  "version": "0.6.0",
  "description": "Evidence-graded scientific literature search for AI agents — multi-database (PubMed, Europe PMC, ChinaXiv, RussiaRxiv), built for medical, clinical and supplementation research.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/emilkrebs/med-research-mcp.git"
  },
  "homepage": "https://github.com/emilkrebs/med-research-mcp#readme",
  "bugs": {
    "url": "https://github.com/emilkrebs/med-research-mcp/issues"
  },
  "author": {
    "name": "Emil Krebs",
    "email": "hello@emilkrebs.dev"
  },
  "keywords": [
    "pubmed",
    "ncbi",
    "mcp",
    "model-context-protocol",
    "evidence-grading",
    "supplements",
    "evidence-based-medicine"
  ],
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "bin": {
    "med-research-mcp": "./dist/mcp/index.js"
  },
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./core/cache": {
      "types": "./dist/core/cache.d.ts",
      "import": "./dist/core/cache.js",
      "require": "./dist/core/cache.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/core",
    "dist/mcp",
    "dist/http",
    "src",
    "skills",
    "mcpb/manifest.json"
  ],
  "scripts": {
    "dev": "tsx watch src/mcp/index.ts",
    "dev:http": "tsx watch src/http/index.ts",
    "build": "tsup && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "start": "node dist/mcp/index.js",
    "start:http": "node dist/http/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mozilla/readability": "^0.6.0",
    "fast-xml-parser": "^5.11.2",
    "jsdom": "^30.1.3",
    "lru-cache": "^11.5.3",
    "pdf-parse": "^2.4.5",
    "turndown": "^7.2.4",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
